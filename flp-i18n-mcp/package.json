{
  "name": "flp-i18n-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP stdio server wrapping the FLP i18n Java CLI",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node18 --outfile=../flp-i18n-plugin/server/dist/index.js",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  }
}
