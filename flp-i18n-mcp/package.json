{
  "name": "@flash-finance/flp-i18n-mcp",
  "version": "0.1.5",
  "description": "MCP stdio server wrapping the FLP i18n Java CLI, with Maven-based jar resolution",
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://registry.flashexpress.pub/repository/npm-internal/"
  },
  "main": "dist/npm/index.js",
  "bin": {
    "flp-i18n-mcp": "dist/npm/index.js"
  },
  "files": [
    "dist/npm/index.js",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node18 --outfile=../flp-i18n-plugin/server/dist/index.js",
    "bundle:npm": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node18 --outfile=dist/npm/index.js",
    "prepack": "npm run build && npm run bundle:npm",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  }
}
